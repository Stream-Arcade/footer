{
  "name": "@stream-arcade/footer",
  "version": "1.0.0",
  "description": "The StreamArcade footer as a React component, with overridable content and design.",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./footer.css": "./dist/footer.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/footer.css','dist/footer.css')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "~6.0.3"
  }
}
